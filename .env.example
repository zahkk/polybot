# Copy to .env and fill in. Never share this file or commit it.

# paper = simulated trades on real data (start here). live = real money.
MODE=paper
PAPER_STARTING_CASH=100

# --- Polymarket (needed for live mode only) ---
# Private key of the wallet that signs orders. If you log in to Polymarket with email,
# export it from Polymarket: Profile > Settings > Export Private Key.
POLY_PRIVATE_KEY=
# The Polymarket wallet address that holds your funds (shown on your Polymarket profile).
POLY_WALLET_ADDRESS=
# Filled in automatically by: python -m polybot.check --approve
POLY_BUILDER_KEY=
POLY_BUILDER_SECRET=
POLY_BUILDER_PASSPHRASE=

# --- Claude (needed for the news forecaster) ---
ANTHROPIC_API_KEY=
CLAUDE_DAILY_BUDGET_USD=0.50

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- X / Twitter (optional, paid per post read; leave empty to skip) ---
X_BEARER_TOKEN=
X_ACCOUNTS=Polymarket,Kalshi

# --- Risk limits (USD) ---
MAX_TOTAL_EXPOSURE_USD=90
DAILY_LOSS_LIMIT_USD=15
MIN_CASH_RESERVE_USD=5

# --- Strategies ---
MM_ENABLED=true
MM_MAX_MARKETS=3
MM_MAX_PER_MARKET_USD=25
FC_ENABLED=true
FC_MAX_TRADE_USD=5
FC_MIN_EDGE=0.08
